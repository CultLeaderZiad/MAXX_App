{
  "expo": {
    "name": "MAXX",
    "slug": "maxx-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maxx.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.maxx.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MAXX needs access to your photos to upload your avatar."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MAXX uses Face ID for quick and secure sign-in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "maxx"
  }
}
